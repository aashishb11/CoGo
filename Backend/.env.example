PORT=3000
LOG_LEVEL=info

# Database
POSTGRES_USER=cogo
POSTGRES_PASSWORD=cogo
POSTGRES_DB=cogo
DATABASE_URL=postgresql://cogo:cogo@localhost:5432/cogo

# Better auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32

# Brevo transactional email (https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
# Sender identity — must be verified in Brevo → Senders, Domain & IP
MAIL_FROM_EMAIL=you@example.com
MAIL_FROM_NAME=CoGo

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# CultuCat events API
CULTUCAT_API_BASE_URL=http://nattech.fib.upc.edu:40373
CULTUCAT_EVENTS_PATH=/external/events
CULTUCAT_API_KEY=replace-me
CULTUCAT_TIMEOUT_MS=5000
# Max allowed distance (km) between a trip's destination and a referenced
# CultuCat event's coordinates.
CULTUCAT_EVENT_MAX_DISTANCE_KM=2

# Traffic alerts — TomTom routing API key (https://developer.tomtom.com)
TOMTOM_API_KEY=your-tomtom-api-key
# Dev/demo only: forces TrafficService to return this delay (seconds) instead
# of calling TomTom. Leave unset in production.
# TOMTOM_FAKE_DELAY_SECONDS=900

# Web Push — generate the keypair once with: npx web-push generate-vapid-keys
# Used for browser (Web Push) subscriptions. Native RN/Expo clients register an
# Expo push token instead and are routed to the Expo push service (below).
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Optional. Authenticates pushes to native (RN/Expo) clients via Expo's push
# service. Create one at https://expo.dev under your account's Access Tokens.
# Unset is allowed (Expo accepts unauthenticated sends) but recommended in prod.
# EXPO_ACCESS_TOKEN=your-expo-access-token

# Partner API — shared secret for the external rides API (/api/partner/v1).
# Generate with: openssl rand -hex 32
PARTNER_API_KEY=replace-with-output-of-openssl-rand-hex-32

# Stripe — test mode end-to-end (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# Payments webhook signing secret. Locally, copy it from the output of
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe`. In prod,
# create the endpoint at https://dashboard.stripe.com/test/webhooks and copy
# the signing secret shown there.
STRIPE_WEBHOOK_SECRET=whsec_your-payments-webhook-secret
# Separate endpoint listening for connected-account events (account.updated,
# payout.failed). Same dashboard page, different endpoint, its own secret.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your-connect-webhook-secret

# Where Stripe sends the user after Checkout / Connect onboarding.
#
# WALLET_RETURN_URL drives Stripe Checkout's success/cancel URLs. Checkout
# accepts custom schemes, so we use the Expo deep link directly — the
# scheme must match cogo-frontend/app.json and the `expoClient({ scheme })`
# in cogo-frontend/src/features/auth/auth-client.ts (currently `cogo`).
WALLET_RETURN_URL=cogo://wallet
# Stripe Connect's `accountLinks.create` rejects custom-scheme URLs and
# only accepts http(s), so the driver onboarding flow bounces through
# two public HTML pages on this backend (GET /api/wallet/connect-return
# and /connect-refresh). The Expo in-app browser closes on the URL match
# and the wallet refetches on focus.
CONNECT_RETURN_URL=https://cogo-backend.onrender.com/api/wallet/connect-return
CONNECT_REFRESH_URL=https://cogo-backend.onrender.com/api/wallet/connect-refresh

# Boarding QR — HMAC secret signing the rotating boarding-token. Generate with:
# openssl rand -hex 32. Rotating tokens are stateless; this secret is the
# only thing preventing forgery so keep it out of source control.
BOARDING_TOKEN_SECRET=replace-with-output-of-openssl-rand-hex-32

# Demo-mode toggle for the final-presentation flow. When set to `true`,
# `POST /dev/traffic-alert` is enabled so the operator can deterministically
# fire the congestion-alert push during step 8.5 of the runbook. Anything
# else (including unset) makes the endpoint return 403. Unset after the
# presentation and redeploy.
DEMO_MODE=false
