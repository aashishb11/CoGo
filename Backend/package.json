{
  "name": "cogo-backend",
  "version": "0.0.1",
  "packageManager": "pnpm@10.30.3",
  "description": "",
  "author": "",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "build": "nest build && tsc-alias -p tsconfig.build.json && (pnpm run docs:asyncapi || echo '[asyncapi] generation failed; runtime will serve fallback')",
    "docs:asyncapi": "node --max-old-space-size=1024 dist/src/scripts/generate-asyncapi.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:staged": "lint-staged",
    "commitlint": "node scripts/check-commit-msg.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "pnpm test:cov:unit && pnpm test:cov:e2e && pnpm test:cov:merge",
    "test:cov:unit": "jest --coverage",
    "test:cov:e2e": "NODE_OPTIONS='--experimental-vm-modules' jest --config ./test/jest-e2e.json --coverage --testTimeout=60000 --forceExit",
    "test:cov:merge": "rm -rf coverage/.tmp && mkdir -p coverage/.tmp && nyc merge coverage/unit coverage/.tmp/unit.json && nyc merge coverage/e2e coverage/.tmp/e2e.json && nyc report --temp-dir=coverage/.tmp --report-dir=coverage --reporter=lcov --reporter=text --reporter=text-summary",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS='--experimental-vm-modules' jest --config ./test/jest-e2e.json --forceExit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:dbml": "ts-node -r tsconfig-paths/register scripts/generate-dbml.ts",
    "db:import-cars": "ts-node -r tsconfig-paths/register scripts/import-fuel-economy.ts",
    "demo:reset": "ts-node -r tsconfig-paths/register scripts/demo-reset.ts"
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.9",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/websockets": "^11.1.19",
    "@scalar/nestjs-api-reference": "^1.1.4",
    "@thallesp/nestjs-better-auth": "^2.6.0",
    "axios": "^1.15.2",
    "better-auth": "^1.6.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "date-fns": "^4.3.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "ical-generator": "^10.2.0",
    "joi": "^18.1.1",
    "nestjs-asyncapi": "^2.0.1",
    "nestjs-pino": "^4.6.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "stripe": "^21.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@jest/globals": "^30.4.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "drizzle-dbml-generator": "^0.10.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^16.4.0",
    "nyc": "^18.0.0",
    "only-allow": "^1.2.2",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage/unit",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^nestjs-asyncapi$": "<rootDir>/../test/mocks/nestjs-asyncapi.ts",
      "^@core/(.*)$": "<rootDir>/core/$1",
      "^@integrations/(.*)$": "<rootDir>/integrations/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@shared/(.*)$": "<rootDir>/shared/$1"
    }
  }
}
